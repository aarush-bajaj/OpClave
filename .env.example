# Copy this file to .env and fill in the values you have.
# cp .env.example .env

# ── Required — at least one model provider must be set for the council to run ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# ── Optional — rate limiting & query logging (Upstash Redis REST API) ──
# Without these, rate limits fail open (unlimited) and logs fall back to
# logs/queries.jsonl on disk.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional — feedback form email delivery (Gmail SMTP app password) ──
GMAIL_APP_PASSWORD=

# ── Optional — protects GET/DELETE /logs behind a shared secret ──
# Leave unset locally; always set this in production.
ADMIN_CODE=

# ── Optional — Supabase auth + cloud sync for threads/artifacts ──
# Run supabase_schema.sql in the Supabase SQL editor first (see README).
SUPABASE_URL=
SUPABASE_ANON_KEY=
